<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Diagonal 1: Back ribbon (top-right to bottom-left) -->
    <path
        android:pathData="M 64,30 L 76,30 L 44,78 L 32,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="70"
                android:startY="30"
                android:endX="38"
                android:endY="78"
                android:type="linear">
                <item android:color="#B80E17" android:offset="0.0" />
                <item android:color="#80090E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Shadow under front ribbon crossing -->
    <path
        android:pathData="M 47,45 L 61,63 L 51,63 L 41,48 Z"
        android:fillColor="#4D000000" />

    <!-- Diagonal 2: Front ribbon (top-left to bottom-right) -->
    <path
        android:pathData="M 32,30 L 44,30 L 76,78 L 64,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="30"
                android:endX="76"
                android:endY="78"
                android:type="linear">
                <item android:color="#FF2E36" android:offset="0.0" />
                <item android:color="#E50914" android:offset="0.6" />
                <item android:color="#B80E17" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glossy edge highlight -->
    <path
        android:pathData="M 32,30 L 35,30 L 67,78 L 64,78 Z"
        android:fillColor="#33FFFFFF" />
</vector>
